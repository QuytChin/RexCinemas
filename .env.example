SPRING_PROFILES_ACTIVE=dev,mysql
DB_URL=jdbc:mysql://localhost:3306/rex_chain_cinema?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
DB_USERNAME=replace-with-local-database-user
DB_PASSWORD=replace-with-local-database-password
JWT_SECRET=replace-with-a-unique-random-value-at-least-32-bytes
MAIL_USERNAME=your-smtp-account@example.com
MAIL_PASSWORD=replace-with-smtp-app-password
COOKIE_SECURE=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public base URL used to build the VietQR payment page and webhook callback configuration
PAYMENT_BASE_URL=http://localhost:8080

# SePay BANK_QR (set real values only in local environment or deployment secrets)
SEPAY_ENABLED=false
SEPAY_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_CODE=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_HOLDER=
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_AUTH_MODE=API_KEY
SEPAY_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
SEPAY_PAYMENT_PREFIX=REX
